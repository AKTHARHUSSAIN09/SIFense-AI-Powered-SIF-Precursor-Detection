# Optional Supabase configuration. Without these values, SIFense runs in demo mode.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional backend URL. Defaults to http://127.0.0.1:8000 in development.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
